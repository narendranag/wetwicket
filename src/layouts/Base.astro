---
import '../styles/global.css';
import { SECTIONS } from '../lib/sections';

interface Props {
  title: string;
  description: string;
  fonts?: string;
}
const { title, description, fonts } = Astro.props;
const path = Astro.url.pathname;
const ARCHIVE = ['/matches/', '/players/', '/competitions/', '/grounds/'];
const NAV = [
  { href: '/series/', name: 'Series', plain: 'Deep dives', match: ['/series/'] },
  ...SECTIONS.map((s) => ({ href: `/${s.id}/`, name: s.name, plain: s.plain, match: [`/${s.id}/`] })),
  { href: '/matches/', name: 'The Archive', plain: 'Matches & players', match: ARCHIVE },
];
const FONTS = fonts ?? 'family=Barlow+Condensed:wght@500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500';
const fullTitle = path === '/' ? title : `${title} · Wet Wicket`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <!-- Google Tag Manager (GTM-NJSJFFP6, analytics.yaml), Consent Mode v2 Advanced: everything denied
       until the reader allows analytics on the banner; before that GA gets cookieless pings only. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    var wwConsent = 'denied';
    try { if (localStorage.getItem('ww-consent') === 'granted') wwConsent = 'granted'; } catch (e) {}
    gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: wwConsent });
    // The interactive pieces call this on the reader's first real use; it sends once per page view.
    window.useInteractive = function (piece) {
      if (window.useInteractive.sent) return;
      window.useInteractive.sent = true;
      dataLayer.push({ event: 'use_interactive', piece: piece });
    };
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-NJSJFFP6');
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Wet Wicket">
  <link rel="canonical" href={new URL(path, Astro.site)}>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="Wet Wicket" href="/rss.xml">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${FONTS}&display=swap`}>
</head>
<body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NJSJFFP6" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <nav class="site-nav" aria-label="Site">
    <div class="inner">
      <a class="wordmark" href="/">
        <svg aria-hidden="true" viewBox="0 0 32 32"><path d="M16 2C16 2 6 14.5 6 20.5a10 10 0 0 0 20 0C26 14.5 16 2 16 2z" fill="var(--accent)"/><path d="M11.5 16.5c1.6 2.4 1.6 6.6 0 9M20.5 16.5c-1.6 2.4-1.6 6.6 0 9" fill="none" stroke="var(--surface)" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="1.6 2"/></svg>
        Wet Wicket
      </a>
      <ul>
        {NAV.map((s) => (
          <li>
            <a href={s.href} aria-current={s.match.some((m) => path.startsWith(m)) ? 'page' : undefined}>
              <span class="nav-name">{s.name}</span><span class="nav-plain">{s.plain}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
  <main>
    <slot />
  </main>
  <footer class="site-foot">
    <div class="inner">
      <p><b>Wet Wicket</b> is a loving exploration of cricket, by cricket lovers, for cricket lovers. <a href="/about/">About</a> · <a href="/rss.xml">RSS</a> · <a href="https://github.com/narendranag/wetwicket">Code and method</a></p>
      <p>Match and player data from <a href="https://cricsheet.org/">Cricsheet</a> by Stephen Rushe, used under the <a href="https://opendatacommons.org/licenses/by/1-0/">Open Data Commons Attribution License 1.0</a>. <a href="/data/">About the data</a>. Wet Wicket is independent and not affiliated with the ICC. <button type="button" class="link-button" data-consent-open>Cookie choice</button></p>
    </div>
  </footer>
  <section class="consent" id="consent" aria-label="Cookie choice" hidden>
    <p>May Google Analytics set a cookie, so we can tell a returning reader from a new one? Until you say yes, it stores nothing on your device and sees only that a page was opened.</p>
    <div class="consent-actions">
      <button type="button" class="consent-yes" data-consent="granted">Allow</button>
      <button type="button" data-consent="denied">No thanks</button>
    </div>
  </section>
  <script is:inline>
    (function () {
      var box = document.getElementById('consent');
      var stored = null;
      try { stored = localStorage.getItem('ww-consent'); } catch (e) {}
      if (stored !== 'granted' && stored !== 'denied') box.hidden = false;
      // Expire _ga and _ga_<stream> on this host and each parent domain gtag may have used.
      function clearCookies() {
        var labels = location.hostname.split('.');
        document.cookie.split(';').forEach(function (c) {
          var name = c.split('=')[0].trim();
          if (name !== '_ga' && name.indexOf('_ga_') !== 0) return;
          for (var i = 0; i < labels.length; i++) {
            var domain = labels.slice(i).join('.');
            document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + (domain.indexOf('.') > 0 ? '; domain=.' + domain : '');
          }
          document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
        });
      }
      box.addEventListener('click', function (e) {
        var choice = e.target.dataset && e.target.dataset.consent;
        if (!choice) return;
        try { localStorage.setItem('ww-consent', choice); } catch (err) {}
        gtag('consent', 'update', { analytics_storage: choice });
        if (choice === 'denied') clearCookies();
        box.hidden = true;
      });
      document.querySelector('[data-consent-open]').addEventListener('click', function () { box.hidden = false; });
    })();
  </script>
</body>
</html>
