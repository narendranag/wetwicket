---
import '../styles/global.css';
import { SECTIONS } from '../lib/sections';

interface Props {
  title: string;
  description: string;
  fonts?: string;
}
const { title, description, fonts } = Astro.props;
const path = Astro.url.pathname;
const ARCHIVE = ['/matches/', '/players/', '/competitions/', '/grounds/'];
const NAV = [
  { href: '/series/', name: 'Series', plain: 'Deep dives', match: ['/series/'] },
  ...SECTIONS.map((s) => ({ href: `/${s.id}/`, name: s.name, plain: s.plain, match: [`/${s.id}/`] })),
  { href: '/matches/', name: 'The Archive', plain: 'Matches & players', match: ARCHIVE },
];
const FONTS = fonts ?? 'family=Barlow+Condensed:wght@500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500';
const fullTitle = path === '/' ? title : `${title} · Wet Wicket`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-H14P5LK5VK"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-H14P5LK5VK');
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Wet Wicket">
  <link rel="canonical" href={new URL(path, Astro.site)}>
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="Wet Wicket" href="/rss.xml">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${FONTS}&display=swap`}>
</head>
<body>
  <nav class="site-nav" aria-label="Site">
    <div class="inner">
      <a class="wordmark" href="/">
        <svg aria-hidden="true" viewBox="0 0 32 32"><path d="M16 2C16 2 6 14.5 6 20.5a10 10 0 0 0 20 0C26 14.5 16 2 16 2z" fill="var(--accent)"/><path d="M11.5 16.5c1.6 2.4 1.6 6.6 0 9M20.5 16.5c-1.6 2.4-1.6 6.6 0 9" fill="none" stroke="var(--surface)" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="1.6 2"/></svg>
        Wet Wicket
      </a>
      <ul>
        {NAV.map((s) => (
          <li>
            <a href={s.href} aria-current={s.match.some((m) => path.startsWith(m)) ? 'page' : undefined}>
              <span class="nav-name">{s.name}</span><span class="nav-plain">{s.plain}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
  <main>
    <slot />
  </main>
  <footer class="site-foot">
    <div class="inner">
      <p><b>Wet Wicket</b> is a loving exploration of cricket, by cricket lovers, for cricket lovers. <a href="/about/">About</a> · <a href="/rss.xml">RSS</a> · <a href="https://github.com/narendranag/wetwicket">Code and method</a></p>
      <p>Match and player data from <a href="https://cricsheet.org/">Cricsheet</a> by Stephen Rushe, used under the <a href="https://opendatacommons.org/licenses/by/1-0/">Open Data Commons Attribution License 1.0</a>. <a href="/data/">About the data</a>. Wet Wicket is independent and not affiliated with the ICC.</p>
    </div>
  </footer>
</body>
</html>
