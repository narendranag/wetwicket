---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PieceCard from '../../components/PieceCard.astro';
import { allPieces } from '../../lib/sections';

export async function getStaticPaths() {
  const pieces = await allPieces();
  return (await getCollection('authors')).map((author) => ({
    params: { slug: author.id },
    props: { author, pieces: pieces.filter((p) => p.data.author.id === author.id) },
  }));
}
const { author, pieces } = Astro.props;
---
<Base title={author.data.name} description={author.data.bio}>
  <div class="page">
    <header class="page-head"><span class="kicker">Author</span><h1>{author.data.name}</h1><p>{author.data.bio}</p></header>
    <div class="cards">{pieces.map((p) => <PieceCard piece={p} />)}</div>
  </div>
</Base>
