---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { seriesPieces, sectionById, sectionOf, urlOf } from '../../lib/sections';

export async function getStaticPaths() {
  return (await getCollection('series')).map((series) => ({ params: { slug: series.id }, props: { series } }));
}
const { series } = Astro.props;
const { Content } = await render(series);
const parts = await seriesPieces(series.id);
---
<Base title={series.data.title} description={series.data.dek}>
  <div class="page">
    <header class="page-head">
      <span class="kicker"><a href="/series/">Series</a> · {series.data.status}</span>
      <h1>{series.data.title}</h1>
      <p>{series.data.dek}</p>
    </header>
    <div class="prose"><Content /></div>
    <section class="series-parts" aria-labelledby="h-parts">
      <h2 class="h-sec" id="h-parts">In this series</h2>
      <ol class="parts">
        {parts.map((p, i) => {
          const s = sectionById(sectionOf(p));
          return (
            <li>
              <a class="part" href={urlOf(p)}>
                <span class="part-no">{i + 1}</span>
                <span class="part-body">
                  <span class="meta">{s.name} · {s.plain}</span>
                  <b>{p.data.title}</b>
                  <span>{p.data.dek}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  </div>
</Base>
<style>
  .series-parts { display: grid; gap: 16px; max-width: 820px; }
  .parts { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .part { display: grid; grid-template-columns: 44px 1fr; gap: 14px; align-items: start; padding: 14px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; color: var(--ink); text-decoration: none; }
  .part:hover { border-color: var(--accent); }
  .part-no { font: 700 34px/1 var(--display); color: var(--accent); font-variant-numeric: tabular-nums; }
  .part-body { display: grid; gap: 4px; }
  .part-body b { font: 700 22px/1.05 var(--display); text-transform: uppercase; }
  .part-body span:last-child { color: var(--muted); font-size: 15px; }
  .meta { font: 500 11.5px/1.3 var(--mono); letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
</style>
